[Unit]
Description=Meituan DataEase sync trigger API
After=network-online.target subsidy-pipeline.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/subsidy
ExecStart=/opt/subsidy/venv/bin/python /opt/subsidy/meituan_sync_api.py --host 0.0.0.0 --port 8311 --state-file /var/lib/subsidy-sync/meituan-status.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
